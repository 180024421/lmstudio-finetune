# 复制为 .env 后按需填写（.env 已在 .gitignore，勿提交密钥）

# HuggingFace Hub 上传（upload_hub.py）
HF_TOKEN=

# Weights & Biases 实验追踪（monitoring.wandb: true 时需要）
WANDB_API_KEY=

# 配置 Profile：dev | prod（对应 config.dev.yaml / config.prod.yaml）
LMSTUDIO_PROFILE=

# FastAPI 模式：proxy（转发 LM Studio）| local（加载 HF+LoRA）
API_MODE=proxy

# Gradio / FastAPI 端口
PORT=7860

# LM Studio API（也可在 config.yaml 的 lm_studio 段配置）
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_API_KEY=lm-studio
